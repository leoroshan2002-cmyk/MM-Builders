{
  "name": "mm-builders",
  "private": true,
  "version": "1.0.0",
  "description": "MM Builders & Infrastructure – React (Vite) + Tailwind frontend, Express + MongoDB backend",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "build": "npm run build --prefix frontend",
    "start": "NODE_ENV=production npm start --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
